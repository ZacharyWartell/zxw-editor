# Default target
#all: build

push: 
	@./embed-revision	
	cd ..; pwd;	git commit -m "Update revision" .
	@echo 'Pushing changes to remote repository...''
	git push
	cd


# Build target
#build: $(TS_FILES)    
build:	
	@echo Root.... {{ZJWP_PROJECT_GIT_ROOT}}
	@echo Building.... {{SRC_DIR}}
	@pushd {{SRC_DIR}} > /dev/null;\
	tsc;\
	sed -i 's/export {};//' main.js
	popd > /dev/null	

revision:
	@./embed-revision "{{SRC_DIR}}"

# git commit -m "Update revision" .	

# Clean target
clean:
	rm -rf {{OUT_DIR}}

# Watch target
watch:
	tsc --watch
