ZJWP_PROJECT_GIT_ROOT := env('ZJWP_PROJECT_GIT_ROOT')
#SRC_DIR := ZJWP_PROJECT_GIT_ROOT / 'www-site'
OUT_DIR := ZJWP_PROJECT_GIT_ROOT / 'www-site'
export VARIABLES_FILE := ZJWP_PROJECT_GIT_ROOT / 'scripts/justfile-variables'
import x"${ZJWP_PROJECT_GIT_ROOT}/scripts/justfile-variables" 
